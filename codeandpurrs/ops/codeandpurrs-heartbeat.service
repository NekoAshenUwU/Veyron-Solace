[Unit]
Description=CodeAndPurrs 缓存保活心跳
After=network-online.target

[Service]
Type=oneshot
WorkingDirectory=/var/www/codeandpurrs
ExecStart=/usr/bin/env node --env-file-if-exists=.env server/heartbeat.mjs
# 闲置多久就不再续命。默认 24 小时太宽——聊完 20 小时都还在为一个
# 没人用的缓存付钱（1h TTL 的缓存写入是 2×，读取 0.1×）。收到 4 小时：
# 覆盖「吃完饭回来接着聊」，不覆盖「睡一觉」。
Environment=HEARTBEAT_MAX_AGE_HOURS=4
