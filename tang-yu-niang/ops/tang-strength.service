[Unit]
Description=棠予酿 strength 重算（衰减那一半）
Documentation=https://github.com/NekoAshenUwU/Veyron-Solace
After=network-online.target

[Service]
Type=oneshot
# 公式在 /root/tang_yu_niang/strength.py，脚本要 import 得到
Environment=PYTHONPATH=/root
ExecStart=/usr/bin/python3 /root/Veyron-Solace/tang-yu-niang/recompute-strength.py --apply

# 只碰这一个库
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ReadWritePaths=/root/data
